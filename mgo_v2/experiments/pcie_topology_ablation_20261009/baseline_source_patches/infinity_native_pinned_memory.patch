--- a/core/memory/host_caching_allocator.cpp
+++ b/core/memory/host_caching_allocator.cpp
@@ -8,6 +8,7 @@
 // replaced c10::alloc_cpu with cudaHostAlloc
 
 #include "host_caching_allocator.h"
+#include <algorithm>
 #include <c10/util/Exception.h>
 #include <cuda_runtime_api.h>
 
@@ -15,6 +16,13 @@ namespace c10 {
 namespace HostCachingAllocator {
 
 std::mutex HostCachingAllocator::mutex_;
+size_t HostCachingAllocator::allocated_bytes_ = 0;
+size_t HostCachingAllocator::peak_allocated_bytes_ = 0;
+
+std::pair<size_t, size_t> HostCachingAllocator::pinned_memory_usage() {
+  std::lock_guard<std::mutex> guard(mutex_);
+  return {allocated_bytes_, peak_allocated_bytes_};
+}
 ska::flat_hash_map<void*, size_t> HostCachingAllocator::allocation_map_;
 
 inline void* HostCachingAllocator::allocate_and_cache(const size_t bytes) {
@@ -30,6 +38,8 @@ inline void* HostCachingAllocator::allocate_and_cache(const size_t bytes) {
   }
 
   allocation_map_[ptr] = bytes;
+  allocated_bytes_ += bytes;
+  peak_allocated_bytes_ = std::max(peak_allocated_bytes_, allocated_bytes_);
   return ptr;
 }
 
@@ -76,6 +86,7 @@ void HostCachingAllocator::record_free(void* ptr) {
   std::lock_guard<std::mutex> guard(mutex_);
   const auto& it = allocation_map_.find(ptr);
   if (it != allocation_map_.end()) {
+    allocated_bytes_ -= it->second;
     allocation_map_.erase(it);
   }
 }
@@ -87,6 +98,7 @@ void HostCachingAllocator::free_cached() {
       cudaFreeHost(ptr);
       // When cached memory is return to OS, it must be removed
       // from allocation_map.
+      allocated_bytes_ -= allocation_map_.at(ptr);
       allocation_map_.erase(ptr);
     }
   }
