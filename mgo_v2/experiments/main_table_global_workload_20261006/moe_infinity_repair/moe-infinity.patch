+import unittest
+import numpy as np
+from transformers import Qwen3MoeConfig
+from moe_infinity.memory.expert_tracer import ExpertTracer
+from moe_infinity.memory.expert_predictor import ExpertPredictor
+from moe_infinity.memory.expert_prefetcher import ExpertPrefetcher
+
+class FakeEngine:
+    def __init__(self): self.queued=[];self.limits={}
+    def configure_phase_policy(self,*args): assert args[:3]==(True,0,0)
+    def set_expert_budget(self,g,b): self.limits[g]=b;return True
+    def replace_expert_priorities(self,ids,scores): self.priorities=dict(zip(ids,scores))
+    def get_node_default_device(self,ids): return ids[0]%2
+    def enqueue_prefetch(self,t,g): self.queued.append((t,g))
+
+class EAMRepairTest(unittest.TestCase):
+    def setUp(self):
+        self.config=Qwen3MoeConfig(num_hidden_layers=3,num_experts=4,num_experts_per_tok=1,architectures=['Qwen3MoeForCausalLM'])
+        self.tracer=ExpertTracer(3,self.config)
+    def test_observed_prefix_and_no_alias(self):
+        a=np.zeros((2,3,4),np.float32)
+        a[0,0,0]=1;a[0,1,1]=2;a[1,0,3]=1;a[1,1,2]=5
+        self.tracer.load_trace(a)
+        q=np.zeros((3,4),np.float32);q[0,0]=1;q[2,3]=999
+        got=self.tracer.find_most_similar(q,0)
+        self.assertEqual(got[1,1],2)
+        got.fill(0);self.assertEqual(self.tracer.trace_collection[0,1,1],2)
+    def test_empty_history_does_not_prefetch_everything(self):
+        predictor=ExpertPredictor(self.config);predictor.add_tracer(self.tracer)
+        sid=self.tracer.create_entry()
+        self.assertFalse(predictor.predict(sid,np.array([1]),0).any())
+    def test_finish_retains_counts_and_releases_request(self):
+        sid=self.tracer.create_entry();self.tracer.update_entry(sid,np.array([2,2]),0)
+        self.tracer.finish_entry(sid)
+        self.assertNotIn(sid,self.tracer.trace)
+        self.assertEqual(self.tracer.trace_collection[0,0,2],2)
+    def test_persistent_full_pool_is_not_overwritten(self):
+        a=np.ones((3,3,4),np.float32);self.tracer.load_trace(a)
+        sid=self.tracer.create_entry();self.tracer.update_entry(sid,np.array([2]),0);self.tracer.finish_entry(sid)
+        np.testing.assert_array_equal(self.tracer.trace_collection,a)
+    def test_batched_search_matches_independent_search(self):
+        rng=np.random.default_rng(13)
+        self.tracer.load_trace(rng.integers(0,5,(3,3,4)).astype(np.float32))
+        queries=rng.integers(0,5,(8,3,4)).astype(np.float32)
+        queries[0]=0
+        for layer in range(3):
+            expected=np.stack([self.tracer.find_most_similar(q,layer) for q in queries])
+            np.testing.assert_array_equal(self.tracer.find_most_similar_batch(queries,layer),expected)
+
+    def test_qwen_wrapper_calls_eam_per_request(self):
+        import torch
+        from moe_store.wrappers.qwen import Qwen3MoEBlock
+        self.config.hidden_size=8;self.config.moe_intermediate_size=4
+        block=Qwen3MoEBlock(self.config);block.layer_id=0
+        block.expert_tracer=self.tracer
+        block.expert_predictor=ExpertPredictor(self.config)
+        block.expert_predictor.add_tracer(self.tracer)
+        p=ExpertPrefetcher(self.config);p.archer_engine=FakeEngine()
+        p.expert_tensor_map={(l,e):l*4+e for l in range(3) for e in range(4)}
+        p.configure_eam_budget([18,9],9);block.expert_prefetcher=p
+        block.seq_id_list=[self.tracer.create_entry() for _ in range(2)]
+        class Executor:
+            def dispatch_local(self,layer,hidden,*args,**kwargs):self.hidden=hidden
+            def wait_dispatch_local(self):return torch.zeros_like(self.hidden)
+        block.expert_executor=Executor()
+        out=block(torch.randn(2,3,8))
+        self.assertEqual(tuple(out.shape),(2,3,8));self.assertEqual(p.eam_calls,1)
+        for sid in block.seq_id_list:self.assertEqual(self.tracer.trace[sid].matrix[0].sum(),3)
+        self.assertEqual(p.eam_candidates,0)
+
+    def test_budget_and_priority_order(self):
+        p=ExpertPrefetcher(self.config);p.archer_engine=FakeEngine()
+        p.expert_tensor_map={(l,e):l*4+e for l in range(3) for e in range(4)}
+        p.configure_eam_budget([18,9],9)
+        scores=np.arange(12,dtype=np.float32).reshape(3,4)
+        p.prefetch_eam(0,scores)
+        self.assertEqual(p.archer_engine.queued,[(11,1),(10,0),(8,0)])
+        self.assertEqual(p.archer_engine.limits,{0:18,1:9})
+        self.assertEqual(len(p.archer_engine.priorities),8)
+        self.assertEqual(p.eam_calls,1)
+
+if __name__=='__main__': unittest.main()
