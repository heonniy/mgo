+TEST_F(ExpertResidencyManagerTest, PredictionPriorityOverridesRecencyButNotLeases) {
+  ASSERT_TRUE(manager->ConfigureCapacity(0, 120));
+  auto hot = MakeNode(1, 60), cold = MakeNode(2, 60);
+  for (auto node : {hot, cold}) {
+    auto t = manager->BeginAdmission(node, 0, ExpertPhase::DECODE,
+                                    AdmissionMode::CACHE, AdmissionSource::DEMAND);
+    node->device = node->default_device;
+    ASSERT_TRUE(manager->CommitAdmission(t));
+  }
+  hot->last_access_time = 1;
+  cold->last_access_time = 100;
+  manager->ReplacePriorities({{hot, 10}, {cold, 1}});
+  auto incoming = MakeNode(3, 60);
+  auto t = manager->BeginAdmission(incoming, 0, ExpertPhase::DECODE,
+                                  AdmissionMode::CACHE, AdmissionSource::DEMAND);
+  ASSERT_TRUE(t.valid);
+  EXPECT_EQ(t.reserved_victim, cold);
+  ASSERT_TRUE(manager->AbortAdmission(t));
+  auto lease = manager->AcquireLease(cold, LeaseKind::EXECUTION);
+  t = manager->BeginAdmission(incoming, 0, ExpertPhase::DECODE,
+                             AdmissionMode::CACHE, AdmissionSource::DEMAND);
+  EXPECT_EQ(t.reserved_victim, hot);
+  ASSERT_TRUE(manager->AbortAdmission(t));
+  ASSERT_TRUE(manager->ReleaseLease(lease));
+  manager->ReplacePriorities({});
+  t = manager->BeginAdmission(incoming, 0, ExpertPhase::DECODE,
+                             AdmissionMode::CACHE, AdmissionSource::DEMAND);
+  EXPECT_EQ(t.reserved_victim, hot);
+  ASSERT_TRUE(manager->AbortAdmission(t));
+  EXPECT_EQ(manager->ResidentBytes(0), 120);
+  EXPECT_EQ(manager->Snapshot().at("gpu_0_peak_charged_bytes"), 120);
