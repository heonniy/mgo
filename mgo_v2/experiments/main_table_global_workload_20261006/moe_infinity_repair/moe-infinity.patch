+bool ExpertResidencyManager::ClearQuiescent(int gpu_id) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto& state = StateFor(gpu_id);
+  // Caller drains queued work and synchronizes devices. Never evict live work.
+  if (!pending_tickets_.empty() || !leases_.empty() ||
+      state.transition_reserved_bytes || state.workspace_bytes) return false;
+  for (const auto& entry : state.entries)
+    if (entry.lease_count || !EventComplete(entry.last_use_event) ||
+        entry.node->exec_state.load(std::memory_order_acquire) != NodeExecState::IDLE ||
+        entry.node->pending_dispatches.load(std::memory_order_acquire) != 0) return false;
+  for (auto it = state.entries.begin(); it != state.entries.end();) {
+    if (transfer_ops_ && !transfer_ops_->MoveToHost(it->node)) return false;
+    state.resident_bytes -= it->bytes;
+    it = state.entries.erase(it);
+  }
+  counters_["gpu_" + std::to_string(gpu_id) + "_peak_charged_bytes"] = 0;
+  counters_["peak_accounted_bytes"] = 0;
+  counters_["priority_evictions"] = 0;
+  counters_["priority_prefetch_rejections"] = 0;
+  counters_["evictions"] = 0;
+  return state.resident_bytes == 0;
+}
+
+void ExpertResidencyManager::ReplacePriorities(
+    const std::vector<std::pair<NodePtr, double>>& priorities) {
+  std::unordered_map<std::size_t, double> next;
+  for (const auto& item : priorities) {
+    if (!item.first || !std::isfinite(item.second) || item.second < 0)
+      throw std::invalid_argument("invalid expert priority");
+    next[item.first->id] = item.second;
+  }
+  std::lock_guard<std::mutex> lock(mutex_);
+  priorities_.swap(next);
+  ++counters_["priority_updates"];
+}
